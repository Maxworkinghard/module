#!category=会员解锁

[Script]
CamScanner = type=http-response,pattern=^https:\/\/.*\.(intsig\.net|camscanner\.com)\/(purchase\/cs\/query_property|queryProperty|getPrivilegeItem),script-path=https://fastly.jsdelivr.net/gh/Maxworkinghard/module@main/scripts/CamScanner.js,requires-body=1,max-size=0

[MITM]
hostname = %APPEND% *.camscanner.com, *.intsig.net
