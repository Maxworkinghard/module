#!name=彩云天气
#!desc=彩云天气去广告与解锁 SVIP、48小时预报与卫星云图 (chxm1023)
#!author=chxm1023
#!category=会员解锁

[Rule]
DOMAIN,gather.colorfulclouds.net,REJECT

[Script]
彩云天气_AD = type=http-response,pattern=^https?:\/\/(ad|biz|wrapper|starplucker)\.cyapi\.cn\/.+\/((activity\?app_name|operation|config|req\?app_name=weather)|v\d\/(trial_card\/info|entries|friend_cards|token\/device)),script-path=https://fastly.jsdelivr.net/gh/Maxworkinghard/module@main/scripts/caiyuntianqi.js,requires-body=1,max-size=0
彩云天气_VIP = type=http-response,pattern=^https?:\/\/(biz|wrapper|starplucker)\.cyapi\.cn\/(v\d\/user\?app_name|.+\/v\d\/(vip_info|user_detail)),script-path=https://fastly.jsdelivr.net/gh/Maxworkinghard/module@main/scripts/caiyuntianqi.js,requires-body=1,max-size=0
彩云天气_MAP = type=http-request,pattern=^https?:\/\/(api|wrapper)\.cyapi\.cn\/v\d\/(satellite|nafp\/origin_images),script-path=https://fastly.jsdelivr.net/gh/Maxworkinghard/module@main/scripts/caiyuntianqi.js

[MITM]
hostname = %APPEND% *.cyapi.cn
